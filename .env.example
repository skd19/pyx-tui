# pyx-panel Configuration

# Host and Port to bind
PANEL_HOST=0.0.0.0
PANEL_PORT=8000

# Secret Access Token (if left empty, auto-generated on startup and printed to terminal)
PANEL_SECRET_TOKEN=

# Inactivity Timeout in minutes before auto-shutdown (fail-safe exit; default 15, 0 to disable)
IDLE_TIMEOUT_MINUTES=15

# Force mock system mode for local dev (automatically true on Windows/macOS)
MOCK_SYSTEM=false

# System Paths (Standard Linux Defaults)
NGINX_SITES_AVAILABLE=/etc/nginx/sites-available
NGINX_SITES_ENABLED=/etc/nginx/sites-enabled
SYSTEMD_SYSTEM_DIR=/etc/systemd/system
APPS_DIR=/opt/apps
